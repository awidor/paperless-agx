    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3"

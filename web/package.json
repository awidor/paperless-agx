{
  "name": "paperless-agx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run fonts && vite",
    "generate:api": "openapi-typescript ../openapi.json -o src/client/generated.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src",
    "test:e2e": "playwright test",
    "build": "bun run fonts && bun run generate:api && tsc --noEmit && vite build",
    "fonts": "bun scripts/fonts.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@solidjs/web": "^2.0.3",
    "pdfjs-dist": "5.4.394",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/diagnostics": "^2.0.3",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/bun": "^1.3.13",
    "happy-dom": "^20.0.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  }
}

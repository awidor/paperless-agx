{
  "openapi": "3.1.0",
  "info": {"title": "Paperless AGX API", "version": "0.1.0"},
  "paths": {
    "/api/health": {"get": {"operationId": "health", "responses": {"200": {"description": "Health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}},
    "/api/documents": {
      "get": {"operationId": "listDocuments", "parameters": [
        {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}},
        {"name": "page_size", "in": "query", "schema": {"type": "integer", "default": 24}},
        {"name": "query", "in": "query", "schema": {"type": ["string", "null"]}},
        {"name": "sender", "in": "query", "schema": {"type": ["string", "null"]}},
        {"name": "created_from", "in": "query", "schema": {"type": ["string", "null"], "format": "date-time"}},
        {"name": "created_to", "in": "query", "schema": {"type": ["string", "null"], "format": "date-time"}},
        {"name": "sort", "in": "query", "schema": {"$ref": "#/components/schemas/DocumentSort"}}
      ], "responses": {"200": {"description": "Documents", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentPageResult"}}}}}},
      "post": {"operationId": "uploadDocument", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary"}, "title": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}}}}}, "responses": {"200": {"description": "Existing document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}, "201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}}}
    },
    "/api/documents/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "uint64"}}],
      "get": {"operationId": "getDocument", "responses": {"200": {"description": "Document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}}},
      "patch": {"operationId": "patchDocument", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentPatch"}}}}, "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}}},
      "delete": {"operationId": "deleteDocument", "responses": {"204": {"description": "Deleted"}}}
    },
    "/api/documents/{id}/file": {"get": {"operationId": "getDocumentFile", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Original file"}}}},
    "/api/documents/{id}/pages": {"get": {"operationId": "getDocumentPages", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Pages", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/PageInfo"}}}}}}}},
    "/api/documents/{id}/thumbnails/{page}": {"get": {"operationId": "getThumbnail", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}, {"name": "page", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "WebP thumbnail"}}}},
    "/api/documents/{id}/pages/{page}/image": {"get": {"operationId": "getPageImage", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}, {"name": "page", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "WebP page render at OCR resolution"}}}},
    "/api/documents/{id}/retry": {"post": {"operationId": "retryDocument", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Retried", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}}}},
    "/api/documents/{id}/infer-metadata": {"post": {"operationId": "inferDocumentMetadata", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Metadata inferred", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}}}},
    "/api/search": {"post": {"operationId": "search", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchRequest"}}}}, "responses": {"200": {"description": "Search results", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchResponse"}}}}}}},
    "/api/search/agent": {"post": {"operationId": "agentSearch", "description": "Runs the search agent. Responds with server-sent events: `progress` (AgentProgress) while it looks things up, then one `result` (AgentSearchResult) or `error` (AgentError).", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentSearchRequest"}}}}, "responses": {"200": {"description": "Agent events", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "503": {"description": "The search agent is not configured or unreachable"}}}},
    "/api/senders": {"get": {"operationId": "senders", "responses": {"200": {"description": "Known senders", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "string"}}}}}}}},
    "/api/openapi.json": {"get": {"operationId": "openapi", "responses": {"200": {"description": "OpenAPI schema"}}}}
  },
  "components": {"schemas": {
    "Document": {"type": "object", "required": ["document_id", "content_hash", "media_type", "filename", "added_at", "updated_at", "page_count", "file_size", "status", "retry_count"], "properties": {
      "document_id": {"type": "integer", "format": "uint64"}, "content_hash": {"type": "array", "items": {"type": "integer"}}, "media_type": {"type": "string", "enum": ["pdf", "image"]}, "filename": {"type": "string"},
      "title": {"type": ["string", "null"]}, "sender": {"type": ["string", "null"]}, "created_at": {"type": ["string", "null"], "format": "date-time"}, "added_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
      "title_source": {"type": ["string", "null"], "enum": ["ai", "manual", null]}, "sender_source": {"type": ["string", "null"], "enum": ["ai", "manual", null]}, "created_at_source": {"type": ["string", "null"], "enum": ["ai", "manual", null]},
      "page_count": {"type": "integer"}, "file_size": {"type": "integer", "format": "uint64"}, "status": {"type": "string", "enum": ["STORED", "PREVIEWING", "OCR", "TEXT_READY", "EMBEDDING", "INDEXING", "READY", "FAILED"]}, "last_error": {"type": ["string", "null"]}, "retry_count": {"type": "integer"}, "deleted_at": {"type": ["string", "null"], "format": "date-time"}, "summary": {"type": ["string", "null"]}
    }},
    "DocumentPatch": {"type": "object", "properties": {"title": {"type": ["string", "null"]}, "sender": {"type": ["string", "null"]}, "created_at": {"type": ["string", "null"], "format": "date-time"}}},
    "DocumentSort": {"type": "string", "enum": ["document_date_desc", "document_date_asc", "added_date_desc", "added_date_asc", "title_asc", "title_desc", "sender_asc", "sender_desc", "file_size_asc", "file_size_desc"], "default": "document_date_desc"},
    "DocumentPageResult": {"type": "object", "required": ["items", "page", "page_size", "total"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Document"}}, "page": {"type": "integer"}, "page_size": {"type": "integer"}, "total": {"type": "integer"}}},
    "OcrBlock": {"type": "object", "required": ["label", "bbox", "text"], "properties": {"label": {"type": "string"}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 1000}}, "text": {"type": "string"}}},
    "PageInfo": {"type": "object", "required": ["page", "thumbnail_ready", "blocks"], "properties": {"page": {"type": "integer"}, "thumbnail_ready": {"type": "boolean"}, "text": {"type": ["string", "null"]}, "blocks": {"type": "array", "items": {"$ref": "#/components/schemas/OcrBlock"}}, "html": {"type": ["string", "null"]}}},
    "SearchRequest": {"type": "object", "required": ["query", "page", "page_size"], "properties": {"query": {"type": "string"}, "page": {"type": "integer"}, "page_size": {"type": "integer"}, "sender": {"type": ["string", "null"]}, "created_from": {"type": ["string", "null"], "format": "date-time"}, "created_to": {"type": ["string", "null"], "format": "date-time"}, "skip_inferred_sender": {"type": "boolean", "default": false}, "skip_inferred_dates": {"type": "boolean", "default": false}}},
    "PassageKind": {"type": "string", "enum": ["page", "summary"], "description": "page: text from a page; summary: the document's AI summary, which has no place on a page."},
    "SearchPassage": {"type": "object", "required": ["chunk_id", "page", "char_start", "char_end", "snippet", "score", "kind"], "properties": {"chunk_id": {"type": "integer", "format": "uint64"}, "page": {"type": "integer"}, "char_start": {"type": "integer"}, "char_end": {"type": "integer"}, "snippet": {"type": "string"}, "score": {"type": "number"}, "kind": {"$ref": "#/components/schemas/PassageKind"}}},
    "SearchHit": {"type": "object", "required": ["document", "best_chunk_id", "page", "snippet", "score", "passages"], "properties": {"document": {"$ref": "#/components/schemas/Document"}, "best_chunk_id": {"type": "integer", "format": "uint64"}, "page": {"type": "integer"}, "snippet": {"type": "string"}, "score": {"type": "number"}, "passages": {"type": "array", "items": {"$ref": "#/components/schemas/SearchPassage"}, "maxItems": 3}}},
    "SearchInterpretation": {"type": "object", "required": ["sender", "created_from", "created_to"], "properties": {"sender": {"type": ["string", "null"]}, "created_from": {"type": ["string", "null"], "format": "date-time"}, "created_to": {"type": ["string", "null"], "format": "date-time"}}},
    "SearchResponse": {"type": "object", "required": ["items", "page", "page_size", "total", "interpretation"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/SearchHit"}}, "page": {"type": "integer"}, "page_size": {"type": "integer"}, "total": {"type": "integer"}, "interpretation": {"$ref": "#/components/schemas/SearchInterpretation"}}},
    "AgentSearchRequest": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "sender": {"type": ["string", "null"]}, "created_from": {"type": ["string", "null"], "format": "date-time"}, "created_to": {"type": ["string", "null"], "format": "date-time"}}},
    "AgentProgress": {"type": "object", "required": ["kind", "label"], "properties": {"kind": {"type": "string", "enum": ["search", "list", "read", "thinking"]}, "label": {"type": "string"}}},
    "AgentResultItem": {"type": "object", "required": ["document", "reason", "passage"], "properties": {"document": {"$ref": "#/components/schemas/Document"}, "reason": {"type": "string"}, "passage": {"$ref": "#/components/schemas/SearchPassage", "description": "Evidence from the archive. chunk_id 0 marks a quote from a page that is not one stored passage; an empty snippet means the page itself is the evidence."}}},
    "AgentSearchResult": {"type": "object", "required": ["answer", "citations", "results"], "properties": {"answer": {"type": ["string", "null"]}, "citations": {"type": "array", "items": {"type": "integer"}, "description": "Indexes into results that support the answer."}, "results": {"type": "array", "items": {"$ref": "#/components/schemas/AgentResultItem"}}}},
    "AgentError": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}}},
    "HealthResponse": {"type": "object", "required": ["status", "ocr_configured", "ocr_base_url", "ocr_model", "metadata_model", "embedding_configured", "embedding_model", "agent_configured"], "properties": {"status": {"type": "string"}, "ocr_configured": {"type": "boolean"}, "ocr_base_url": {"type": "string"}, "ocr_model": {"type": "string"}, "metadata_model": {"type": "string"}, "embedding_configured": {"type": "boolean"}, "embedding_model": {"type": "string"}, "agent_configured": {"type": "boolean"}}}
  }}
}
